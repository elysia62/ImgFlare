# Local development — COPY THIS TO `.dev.vars` AND EDIT.
#
# `.dev.vars` is git-ignored. Never commit real values.

# Admin credentials. The username is also set in `wrangler.toml`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-password

# HMAC key for session cookies. Generate a real one with:
#   openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-please-change-me

# Turnstile test keys — always pass, safe for local development.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# The site key also overrides the placeholder in `wrangler.toml`, so the widget
# actually renders locally.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# Local origins.
#
# The Worker refuses to run when PUBLIC_BASE_URL and PANEL_ORIGIN share an
# origin, so `localhost` and `127.0.0.1` are used deliberately: they are
# different origins to a browser, and both resolve to the local dev server.
#
# Open the panel at http://localhost:8787
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://127.0.0.1:8787
PANEL_ORIGIN=http://localhost:8787

# Only needed to test the D1 backup locally.
CLOUDFLARE_API_TOKEN=dev-token-not-used-locally
